 int faiss_handle_unknown_exception() {
+#if defined(__APPLE__)
+    if (const std::type_info* type = abi::__cxa_current_exception_type()) {
+        void* object = abi::__cxa_current_primary_exception();
+        const void* found = object ? find_std_exception(type, object) : nullptr;
+        if (found) {
+            faiss_set_last_error(
+                    static_cast<const std::exception*>(found)->what());
+        }
+        abi::__cxa_decrement_exception_refcount(object);
+        if (found) {
+            return -4;
+        }
+    }
+#endif
     faiss_set_last_error("Unknown error");
     return -1;
 }
