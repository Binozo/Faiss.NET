diff --git a/c_api/error_impl.cpp b/c_api/error_impl.cpp
index a0c2d52fe..ee1c9ed47 100644
--- a/c_api/error_impl.cpp
+++ b/c_api/error_impl.cpp
@@ -10,17 +10,62 @@
 #include "error_impl.h"
 #include <faiss/impl/FaissException.h>
 #include <exception>
+#include <string>
+#if defined(__APPLE__)
+#include <cxxabi.h>
+#include <dlfcn.h>
+#include <cstdio>
+#include <stdexcept>
+#include <typeinfo>
+#endif
 #include "error_c.h"
 
 thread_local std::exception_ptr faiss_last_exception;
 
+namespace {
+thread_local std::string faiss_last_error_message;
+}
+
 const char* faiss_get_last_error() {
     if (faiss_last_exception) {
         try {
             std::rethrow_exception(faiss_last_exception);
         } catch (std::exception& e) {
-            return e.what();
+            faiss_last_error_message = e.what();
+            return faiss_last_error_message.c_str();
         }
     }
     return nullptr;
 }
+
+#if defined(__APPLE__)
+namespace {
+std::string describe_type_info(const char* label, const std::type_info* t) {
+    Dl_info info = {};
+    const char* image =
+            t && dladdr(t, &info) && info.dli_fname ? info.dli_fname : "?";
+    char buf[512];
+    std::snprintf(
+            buf,
+            sizeof(buf),
+            " %s{name=%s ti=%p name_ptr=%p image=%s}",
+            label,
+            t ? t->name() : "null",
+            (const void*)t,
+            t ? (const void*)t->name() : nullptr,
+            image);
+    return buf;
+}
+}
+#endif
+
+std::string faiss_describe_unknown_exception() {
+    std::string message = "Unknown error";
+#if defined(__APPLE__)
+    message += describe_type_info("thrown", abi::__cxa_current_exception_type());
+    message += describe_type_info("std::exception", &typeid(std::exception));
+    message += describe_type_info(
+            "std::out_of_range", &typeid(std::out_of_range));
+#endif
+    return message;
+}
