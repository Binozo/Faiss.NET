<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <Deterministic>true</Deterministic>
        
        <AssemblyName>FaissNet</AssemblyName>

        <PackageId>Faiss.NET.Interop</PackageId>
        <Version>1.0.0-preview.4</Version>
        <Authors>Binozo</Authors>
        <Description>Modern C# bindings for Faiss.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Noah Czaplewski</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Binozo/Faiss.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Binozo/Faiss.NET</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\FaissNET.Core\**\*.cs"
                 Exclude="..\FaissNET.Core\bin\**;..\FaissNET.Core\obj\**"
                 LinkBase="Core\%(RecursiveDir)" />

        <Compile Include="..\FaissNET.Interop\**\*.cs"
                 Exclude="..\FaissNET.Interop\bin\**;..\FaissNET.Interop\obj\**"
                 LinkBase="Interop\%(RecursiveDir)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FaissNet.Gpu" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
