<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <PackageId>Faiss.NET.Native.Windows</PackageId>
        <Version>1.0.0-preview.4</Version>
        <Authors>Binozo</Authors>
        <Description>Native Windows (x64 and arm64) binaries for Faiss.NET.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings windows x64 arm64</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Noah Czaplewski</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Binozo/Faiss.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Binozo/Faiss.NET</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Cpu\Faiss.Cpu.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="runtimes\windows-x64\native\*.dll"
              Pack="true"
              PackagePath="runtimes\win-x64\native\" />

        <None Include="runtimes\windows-arm64\native\*.dll"
              Pack="true"
              PackagePath="runtimes\win-arm64\native\" />
    </ItemGroup>

    <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
        <ContentWithTargetPath Include="runtimes\windows-x64\native\*.dll"
                               TargetPath="%(Filename)%(Extension)"
                               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
        <ContentWithTargetPath Include="runtimes\windows-arm64\native\*.dll"
                               TargetPath="%(Filename)%(Extension)"
                               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>