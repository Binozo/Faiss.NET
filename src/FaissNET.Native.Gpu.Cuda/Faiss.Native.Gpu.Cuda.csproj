<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <PackageId>Faiss.NET.Gpu.Native.Cuda</PackageId>
        <Version>1.0.0-preview.5</Version>
        <Authors>Binozo</Authors>
        <Description>Meta-package for NVIDIA GPUs. Includes Linux CUDA runtimes.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings linux gpu cuda nvidia x64 arm64</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Noah Czaplewski</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Binozo/Faiss.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Binozo/Faiss.NET</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Gpu\Faiss.Gpu.csproj" />
        <ProjectReference Include="..\FaissNET.Linux.Gpu.Cuda\Faiss.Linux.Gpu.Cuda.csproj" />
<!--        <ProjectReference Include="..\FaissNET.Windows.Gpu.Cuda\Faiss.Windows.Gpu.Cuda.csproj" />-->
    </ItemGroup>

</Project>