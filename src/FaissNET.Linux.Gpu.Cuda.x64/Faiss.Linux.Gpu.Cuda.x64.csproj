<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <PackageId>Faiss.NET.Gpu.Native.Cuda.Linux.x64</PackageId>
        <Description>Native Linux x64 CUDA 13.2 binaries for the Faiss.NET GPU extension. Requires an NVIDIA GPU.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings linux gpu cuda nvidia x64</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Gpu\Faiss.Gpu.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="runtimes\linux-x64\native\*.so"
              Pack="true"
              PackagePath="runtimes\linux-x64\native\" />
    </ItemGroup>

    <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
        <ContentWithTargetPath Include="runtimes\linux-x64\native\*.so"
                               TargetPath="%(Filename)%(Extension)"
                               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>