<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <PackageId>Faiss.NET.Gpu.Native.Cuda12.Linux</PackageId>
        <Description>Meta package for Linux (x64 and arm64) CUDA 12.8 binaries for the Faiss.NET GPU extension. Requires an NVIDIA GPU.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings linux gpu cuda nvidia x64 arm64</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Gpu\Faiss.Gpu.csproj" />
        <ProjectReference Include="..\FaissNET.Linux.Gpu.Cuda12.x64\Faiss.Linux.Gpu.Cuda12.x64.csproj" />
        <ProjectReference Include="..\FaissNET.Linux.Gpu.Cuda12.arm64\Faiss.Linux.Gpu.Cuda12.arm64.csproj" />
    </ItemGroup>

</Project>