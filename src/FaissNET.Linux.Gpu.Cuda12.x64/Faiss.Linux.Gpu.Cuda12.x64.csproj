<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <PackageId>Faiss.NET.Gpu.Native.Cuda12.Linux.x64</PackageId>
        <Version>1.0.0-preview.3</Version>
        <Authors>Binozo</Authors>
        <Description>Native Linux x64 CUDA 12.8 binaries for the Faiss.NET GPU extension. Requires an NVIDIA GPU.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings linux gpu cuda nvidia x64</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Noah Czaplewski</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Binozo/Faiss.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Binozo/Faiss.NET</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Gpu\Faiss.Gpu.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="runtimes\linux-x64\native\*.so"
              Pack="true"
              PackagePath="runtimes\linux-x64\native\" />
    </ItemGroup>

    <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
        <ContentWithTargetPath Include="runtimes\linux-x64\native\*.so"
                               TargetPath="%(Filename)%(Extension)"
                               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>