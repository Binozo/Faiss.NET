<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <PackageId>Faiss.NET.Native</PackageId>
        <Version>1.0.0-preview.5</Version>
        <Authors>Binozo</Authors>
        <Description>Cross-platform native binaries meta-package for Faiss.NET. Includes Linux, Windows, and macOS runtimes.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings linux windows macos cross-platform x64 arm64</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Noah Czaplewski</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Binozo/Faiss.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Binozo/Faiss.NET</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Cpu\Faiss.Cpu.csproj" />
        <ProjectReference Include="..\FaissNET.Linux\Faiss.Linux.csproj" />
        <ProjectReference Include="..\FaissNET.Windows\Faiss.Windows.csproj" />
        <ProjectReference Include="..\FaissNET.MacOS\Faiss.MacOS.csproj" />
    </ItemGroup>

</Project>