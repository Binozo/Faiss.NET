<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <PackageId>Faiss.NET.Native.MacOS</PackageId>
        <Version>1.0.0-preview.2</Version>
        <Authors>Binozo</Authors>
        <Description>Native MacOS (x64 and arm64) binaries for Faiss.NET.</Description>
        <PackageTags>faiss vector search similarity-search machine-learning ai knn hnsw embeddings macos x64 arm64</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Copyright (c) 2026 Noah Czaplewski</Copyright>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/Binozo/Faiss.NET</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Binozo/Faiss.NET</PackageProjectUrl>
    </PropertyGroup>

    <PropertyGroup>
        <ContentTargetFolders>runtimes</ContentTargetFolders>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Cpu\Faiss.Cpu.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="runtimes\macos-x64\native\*.dylib">
            <Pack>true</Pack>
            <PackagePath>runtimes\macos-x64\native\</PackagePath>

            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <Content Include="runtimes\macos-arm64\native\*.dylib">
            <Pack>true</Pack>
            <PackagePath>runtimes\macos-arm64\native\</PackagePath>

            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>