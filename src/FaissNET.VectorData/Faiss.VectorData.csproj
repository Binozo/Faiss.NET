<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
        <PackageId>Faiss.NET.VectorData</PackageId>
        <RootNamespace>FaissNet.VectorData</RootNamespace>
        <Description>Microsoft.Extensions.VectorData connector for Faiss.NET</Description>
        <NoWarn>$(NoWarn);MEVD9001</NoWarn>
        <IsTrimmable>false</IsTrimmable>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="[10.9.0]" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FaissNET.Cpu\Faiss.Cpu.csproj" />
    </ItemGroup>
</Project>